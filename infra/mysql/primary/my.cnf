[mysqld]
# --- Primario de la replicacion ClinicaCore (MySQL 8) ---
# Identidad unica en la topologia (1 = primario).
server-id = 1

# Binlog clasico en formato ROW para replicacion basada en posicion.
log_bin = mysql-bin
binlog_format = ROW

# El primario acepta escrituras.
read_only = OFF

# Retencion acotada del binlog (evita crecimiento ilimitado en un solo nodo).
binlog_expire_logs_seconds = 604800
