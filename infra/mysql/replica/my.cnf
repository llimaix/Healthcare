[mysqld]
# --- Replica de la replicacion ClinicaCore (MySQL 8) ---
# Identidad unica en la topologia (2 = replica).
server-id = 2

# Relay log de la replica (donde aterrizan los eventos leidos del primario).
relay_log = mysql-relay-bin

# La replica es de solo lectura; solo el hilo SQL de replicacion escribe.
read_only = ON

# Binlog propio (permite promover la replica a primario sin reinstalar binlog).
log_bin = mysql-bin
binlog_format = ROW
