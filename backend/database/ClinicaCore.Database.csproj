<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Pomelo 9.0.0 (ultima estable, 2025-08-17) depende de EF Core Relational 9.0.x.
    Por eso todos los paquetes de EF Core se fijan en 9.0.x aunque el SDK sea .NET 10.
    Ver docs/decisiones.md para el detalle.
  -->
  <ItemGroup>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <!-- Pomelo 9.0.0 trae MySqlConnector 2.4.0 (NU1902: GHSA-473q-m89c-ghf8).
         Se sube a 2.6.2, que corrige la vulnerabilidad y es compatible (Pomelo pide >= 2.4.0). -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
